# Local development
PORT=3000
NODE_ENV=development
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=24h
CLIENT_URL=http://localhost:5173

# Railway production env vars (set di Railway dashboard, jangan commit):
#   NODE_ENV=production
#   DATABASE_URL=<otomatis disediakan Railway Postgres plugin>
#   JWT_SECRET=<random string panjang>
#   JWT_EXPIRES_IN=24h
#   CLIENT_URL=https://preface-system-internal.vercel.app
#     -> Boleh comma-separated kalau ada beberapa domain:
#        CLIENT_URL=https://preface-system-internal.vercel.app,https://app.domain.com
