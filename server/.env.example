# Local development
PORT=3000
NODE_ENV=development
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173

# Cloudinary (upload gambar produk). Daftar gratis di https://cloudinary.com,
# lalu copy tiga nilai dari dashboard → "API Environment variable".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Railway production env vars (set di Railway dashboard, jangan commit):
#   NODE_ENV=production
#   DATABASE_URL=<otomatis disediakan Railway Postgres plugin>
#   JWT_SECRET=<random string panjang>
#   JWT_EXPIRES_IN=8h
#   CLIENT_URL=https://preface-system-internal.vercel.app
#   CLOUDINARY_CLOUD_NAME=<dari dashboard Cloudinary>
#   CLOUDINARY_API_KEY=<dari dashboard Cloudinary>
#   CLOUDINARY_API_SECRET=<dari dashboard Cloudinary>

# Cloudflare R2 (upload video unboxing barang masuk, langsung dari browser).
# Bucket perlu CORS: AllowedOrigins = URL frontend, AllowedMethods = PUT, GET,
# AllowedHeaders = Content-Type. R2_PUBLIC_URL = domain publik bucket (r2.dev / custom).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
