# Local development
PORT=3000
NODE_ENV=development
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=24h
CLIENT_URL=http://localhost:5173

# Cloudinary (upload gambar produk). Daftar gratis di https://cloudinary.com,
# lalu copy tiga nilai dari dashboard → "API Environment variable".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Railway production env vars (set di Railway dashboard, jangan commit):
#   NODE_ENV=production
#   DATABASE_URL=<otomatis disediakan Railway Postgres plugin>
#   JWT_SECRET=<random string panjang>
#   JWT_EXPIRES_IN=24h
#   CLIENT_URL=https://preface-system-internal.vercel.app
#   CLOUDINARY_CLOUD_NAME=<dari dashboard Cloudinary>
#   CLOUDINARY_API_KEY=<dari dashboard Cloudinary>
#   CLOUDINARY_API_SECRET=<dari dashboard Cloudinary>
